# ==============================================================================
# Development Environment Variables Template (.env.development)
# Mirrored from .env.example with local development defaults
# Loaded automatically by Next.js during 'next dev'
# Gitignored to prevent exposing local machine secrets
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Core & Server Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOSTNAME=localhost
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Production & Reverse Proxy Configuration (Docker / Traefik)
# ------------------------------------------------------------------------------
DOMAIN=localhost
IMAGE_TAG=latest
TRAEFIK_NETWORK=traefik-net
CERT_RESOLVER=letsencrypt

# ------------------------------------------------------------------------------
# 3. Integrations & Third-Party APIs
# ------------------------------------------------------------------------------
CONTACT_RECIPIENT_EMAIL=contact@example.com
# RESEND_API_KEY=

# ------------------------------------------------------------------------------
# 4. Real User Monitoring (RUM) & Web Vitals
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_WEB_VITALS=true
NEXT_PUBLIC_VITALS_ENDPOINT=/api/telemetry/vitals

# ------------------------------------------------------------------------------
# 5. OpenTelemetry (OTel) Distributed Tracing
# ------------------------------------------------------------------------------
# Set to 'true' to disable OTel in local dev/testing; 'false' to enable
OTEL_SDK_DISABLED=true
OTEL_SERVICE_NAME=my-nextjs-app-dev
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/json
OTEL_BSP_SCHEDULE_DELAY=1000
OTEL_LOG_LEVEL=info

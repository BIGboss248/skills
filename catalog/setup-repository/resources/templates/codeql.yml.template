# CodeQL code scanning — NON-BLOCKING (F13)
#
# Contract, do not weaken it:
#   * There is no `pull_request` trigger. PR annotations are what actually block
#     merges, so the absence of that trigger is the non-blocking guarantee.
#   * Never add this workflow to required status checks, a ruleset, a deployment
#     environment gate, or the Release Please flow. Branch protection (F9) must
#     not require it.
#   * Findings are handled as review follow-up, not as a merge gate. The job is
#     allowed to end red; a `notify` job turns that red into a tracking issue.
#
# Generated by setup-repository (F13). Edit the matrix, not the triggers.

name: CodeQL (non-blocking)

on:
  push:
    branches: [main]
    paths-ignore:
      - '**/*.md'
      - '**/*.txt'
  schedule:
    - cron: "30 6 * * 1" # weekly, Monday 06:30 UTC
  release:
    types: [published] # ship-time scan; does not gate the release
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: codeql-${{ github.ref }}
  cancel-in-progress: true

jobs:
  analyze:
    name: Analyze (${{ matrix.language }})
    runs-on: ubuntu-latest
    permissions:
      security-events: write # upload SARIF
      contents: read
      actions: read # required for private repositories
    strategy:
      fail-fast: false
      matrix:
        include:
          - language: javascript-typescript
            build-mode: none
          # Add one entry per language detected by F13. Compiled languages:
          # none | autobuild | manual (manual requires explicit build steps).
          # - language: python
          #   build-mode: none
          # - language: csharp
          #   build-mode: autobuild
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Initialize CodeQL
        uses: github/codeql-action/init@v4
        with:
          languages: ${{ matrix.language }}
          build-mode: ${{ matrix.build-mode }}
          queries: security-extended
          dependency-caching: true

      - name: Perform CodeQL Analysis
        uses: github/codeql-action/analyze@v4
        with:
          category: "/language:${{ matrix.language }}"

  notify:
    name: Notify on analysis failure
    needs: analyze
    if: always() && needs.analyze.result == 'failure'
    runs-on: ubuntu-latest
    permissions:
      contents: read
      issues: write
    steps:
      - name: Write failure summary
        run: |
          {
            echo "## ⚠️ CodeQL analysis did not complete"
            echo ""
            echo "| Field | Value |"
            echo "| :--- | :--- |"
            echo "| Result | \`${{ needs.analyze.result }}\` |"
            echo "| Ref | \`${{ github.ref }}\` |"
            echo "| Commit | \`${{ github.sha }}\` |"
            echo "| Run | [${{ github.run_id }}](${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}) |"
            echo ""
            echo "This scan is non-blocking: nothing was gated. Fix the analysis, or"
            echo "record why it cannot run. Alerts themselves are in the Security tab."
          } >> "$GITHUB_STEP_SUMMARY"

      - name: Open or update the tracking issue
        if: vars.CODEQL_OPEN_ISSUE != 'false'
        uses: actions/github-script@v7
        env:
          WORKFLOW_RESULT: ${{ needs.analyze.result }}
        with:
          script: |
            const { owner, repo } = context.repo;
            const marker = '<!-- codeql-notify -->';
            const key = 'CodeQL analysis failed';
            const ref = context.ref.replace('refs/heads/', '').replace('refs/tags/', 'tag:');
            const title = `chore(security): ${key} on \`${ref}\``;
            const body = [
              marker,
              `The non-blocking CodeQL workflow reported **${process.env.WORKFLOW_RESULT}**.`,
              '',
              `- Ref: \`${context.ref}\``,
              `- Commit: \`${context.sha}\``,
              `- Run: ${context.serverUrl}/${owner}/${repo}/actions/runs/${context.runId}`,
              '',
              'Nothing was blocked. Triage the extraction/build error, then close this',
              'issue. Alert findings stay in the Security tab and are handled as',
              'CodeQL alerts, not as issues.',
            ].join('\n');

            try {
              const search = await github.rest.search.issuesAndPullRequests({
                q: `repo:${owner}/${repo} is:issue is:open in:title "${key}"`,
                per_page: 10,
              });
              const existing = search.data.items.find(
                (i) => i.title.includes(key) && !i.pull_request
              );

              if (existing) {
                await github.rest.issues.createComment({
                  owner,
                  repo,
                  issue_number: existing.number,
                  body,
                });
                core.info(`Commented on #${existing.number}`);
                return;
              }

              try {
                await github.rest.issues.create({
                  owner,
                  repo,
                  title,
                  body,
                  labels: ['security', 'codeql'],
                });
              } catch (labelError) {
                core.warning(`Retrying without labels: ${labelError.message}`);
                await github.rest.issues.create({ owner, repo, title, body });
              }
            } catch (error) {
              // Issues disabled, or the token cannot write them. The step summary
              // above already carries the signal, so never fail the notifier.
              core.warning(`Could not file the tracking issue: ${error.message}`);
            }

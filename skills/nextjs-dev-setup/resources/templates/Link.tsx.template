"use client";

import * as React from "react";
import { useLinkStatus } from "next/link";
import { Link as I18nLink } from "@/i18n/navigation";

/**
 * Composite link primitive.
 *
 * Requirement: `next@15.3+` (useLinkStatus was introduced in 15.3). The skill
 * always installs the latest release, so no version guard is needed in code.
 *
 * The pending indicator is per link: `useLinkStatus` reads the transition state
 * of the nearest ancestor `<Link>` only. Never replace it with a global
 * progress-bar library or provider.
 *
 * When N4 (next-intl) is disabled, change the import above to
 * `import Link as I18nLink from "next/link";` and keep everything else.
 */
export interface LinkProps extends React.ComponentProps<typeof I18nLink> {
  /**
   * Prefetch strategy (App Router):
   * - `"auto"` / `null` / `undefined` (default): static routes prefetch fully;
   *   dynamic routes prefetch down to the nearest `loading.js` boundary.
   * - `true`: full route prefetch for static and dynamic routes (1 server
   *   invocation) — reserve for high-intent primary CTAs.
   * - `false`: no prefetch on viewport entry or hover. The most useful setting
   *   for `useLinkStatus`: pending feedback is otherwise skipped when the route
   *   was already prefetched.
   */
  prefetch?: boolean | "auto" | null;
  /**
   * Render the inline pending indicator while this link's navigation is in
   * flight.
   * @defaultValue true
   */
  showPendingIndicator?: boolean;
}

interface LinkStatusIndicatorProps {
  readonly className?: string;
}

/**
 * Inline, decorative pending indicator driven by Next's `useLinkStatus`.
 *
 * Must be rendered as a descendant of the `<Link>` it reports on. It:
 * - reserves a fixed size and always occupies space (no layout shift),
 * - fades in only after ~100ms, so sub-100ms navigations never flash,
 * - pulses only while pending, and stops for `prefers-reduced-motion`,
 * - carries no copy and is `aria-hidden` (decorative hint, not a status).
 */
export function LinkStatusIndicator({
  className = "",
}: LinkStatusIndicatorProps): React.JSX.Element {
  const { pending } = useLinkStatus();

  return (
    <span
      aria-hidden="true"
      data-pending={pending}
      className={`ms-2 inline-block size-1.5 shrink-0 transition-opacity duration-150 delay-100 motion-reduce:transition-none ${
        pending ? "opacity-100" : "opacity-0"
      } ${className}`.trim()}
    >
      <span className="block size-full rounded-full bg-current animate-pulse motion-reduce:animate-none" />
    </span>
  );
}

/**
 * Single link primitive for the app.
 *
 * Composes next-intl's locale-aware `Link` (so every href carries the active
 * locale prefix and client navigation never relies on proxy negotiation) with
 * Next's built-in `useLinkStatus` pending indicator. No progress-bar library is
 * involved.
 *
 * Supports optimized Next.js App Router prefetching:
 * - Default (`prefetch={null}`): bounded App Shell / partial prefetch.
 * - `prefetch={true}`: full dynamic URL data prefetch for instant transitions.
 * - `prefetch={false}`: never prefetch; pending feedback is always observable.
 */
export function Link({
  showPendingIndicator = true,
  children,
  ...props
}: LinkProps): React.JSX.Element {
  return (
    <I18nLink {...props}>
      {children}
      {showPendingIndicator ? <LinkStatusIndicator /> : null}
    </I18nLink>
  );
}

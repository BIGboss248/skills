import { NextRequest } from "next/server";

export const runtime = "nodejs";
export const dynamic = "force-dynamic";

/**
 * GET /api/v1/[resource]/stream - Real-time Server-Sent Events (SSE) stream
 */
export async function GET(request: NextRequest) {
  const encoder = new TextEncoder();

  const stream = new ReadableStream({
    async start(controller) {
      try {
        // Heartbeat or event iteration
        for (let i = 1; i <= 10; i++) {
          // Respect client disconnect abort signal
          if (request.signal.aborted) {
            break;
          }

          const payload = {
            event: "update",
            data: { step: i, timestamp: new Date().toISOString() },
          };

          controller.enqueue(encoder.encode(`data: ${JSON.stringify(payload)}\n\n`));
          await new Promise((resolve) => setTimeout(resolve, 1000));
        }
      } catch (err) {
        console.error("Stream error:", err);
      } finally {
        controller.close();
      }
    },
  });

  return new Response(stream, {
    headers: {
      "Content-Type": "text/event-stream; charset=utf-8",
      "Cache-Control": "no-cache, no-transform",
      "Connection": "keep-alive",
      "X-Accel-Buffering": "no", // Disables buffering on Nginx / Traefik
    },
  });
}

# ==============================================================================
# Next.js Application Environment Variables Specification (.env.example)
# Single Source of Truth for Environment Configuration
# ==============================================================================
#
# NEXT.JS ENVIRONMENT VARIABLE LOAD ORDER PRECEDENCE:
# 1. System process.env (or container environment variables)
# 2. .env.$(NODE_ENV).local (e.g. .env.development.local, .env.production.local)
# 3. .env.local (ignored when NODE_ENV=test)
# 4. .env.$(NODE_ENV) (e.g. .env.development, .env.production)
# 5. .env (default fallback)
#
# SECURITY & USAGE RULES:
# - NEVER commit '.env*.local' or secret keys (API keys, database passwords, signing tokens).
# - Variables prefixed with 'NEXT_PUBLIC_' are inlined into client JS at build time.
# - Non-prefixed variables are strictly available on the server runtime (Node.js).
# - Whenever a new environment variable is introduced into the project, immediately append
#   and document it in this file (.env.example).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Core & Server Configuration
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
NEXT_PUBLIC_BASE_URL=https://example.com

# ------------------------------------------------------------------------------
# 2. Production & Reverse Proxy Configuration (Docker / Traefik)
# ------------------------------------------------------------------------------
DOMAIN=example.com
IMAGE_TAG=latest
TRAEFIK_NETWORK=traefik-net
CERT_RESOLVER=letsencrypt

# ------------------------------------------------------------------------------
# 3. Integrations & Third-Party APIs
# ------------------------------------------------------------------------------
CONTACT_RECIPIENT_EMAIL=contact@example.com
# RESEND_API_KEY=

# ------------------------------------------------------------------------------
# 4. Real User Monitoring (RUM) & Web Vitals
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_WEB_VITALS=true
NEXT_PUBLIC_VITALS_ENDPOINT=/api/telemetry/vitals

# ------------------------------------------------------------------------------
# 5. OpenTelemetry (OTel) Distributed Tracing
# ------------------------------------------------------------------------------
# Set to 'true' to disable OTel in local dev/testing; 'false' to enable
OTEL_SDK_DISABLED=true
OTEL_SERVICE_NAME=my-nextjs-app
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/json
OTEL_BSP_SCHEDULE_DELAY=5000
OTEL_LOG_LEVEL=warn

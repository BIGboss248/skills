# ==============================================================================
# Next.js Production Environment Variables Template (.env.example)
# Single Source of Truth for Production Deployments & Container Stacks
# ==============================================================================
#
# NEXT.JS ENVIRONMENT VARIABLE LOAD ORDER PRECEDENCE:
# 1. System process.env (or container environment variables)
# 2. .env.$(NODE_ENV).local (e.g. .env.development.local, .env.production.local)
# 3. .env.local (ignored when NODE_ENV=test)
# 4. .env.$(NODE_ENV) (e.g. .env.development, .env.production)
# 5. .env (default fallback)
#
# SECURITY & BUILD RULES:
# - NEVER commit '.env*.local' or secret credentials to version control.
# - Variables prefixed with 'NEXT_PUBLIC_' are inlined into client JavaScript during 'next build'.
# - Non-prefixed variables are strictly available in the server runtime (Node.js).
# - Whenever a new environment variable is added to any component or route, document it here immediately.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Core & Server Configuration
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
NEXT_PUBLIC_BASE_URL=https://<domain>

# ------------------------------------------------------------------------------
# 2. Server Action Encryption & Version Skew Protection
# ------------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# ------------------------------------------------------------------------------
# 3. Production Container & Reverse Proxy Configuration (Traefik / Nginx)
# ------------------------------------------------------------------------------
DOMAIN_NAME=<domain>
CONTAINER_NAME=nextjs-standalone-app
IMAGE_TAG=latest
TRAEFIK_ROUTER_NAME=nextjs-app
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_TLS_ENABLED=true
TRAEFIK_CERTRESOLVER=letsencrypt

# ------------------------------------------------------------------------------
# 4. Email & Contact Integration
# ------------------------------------------------------------------------------
CONTACT_RECIPIENT_EMAIL=contact@<domain>
RESEND_API_KEY=

# ------------------------------------------------------------------------------
# 5. Real User Monitoring (RUM) & Web Vitals
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_WEB_VITALS=true
NEXT_PUBLIC_VITALS_ENDPOINT=/api/telemetry/vitals

# ------------------------------------------------------------------------------
# 6. OpenTelemetry (OTel) Observability & Tracing
# ------------------------------------------------------------------------------
OTEL_SDK_DISABLED=true
OTEL_SERVICE_NAME=<project-name>
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/json
OTEL_BSP_SCHEDULE_DELAY=5000
OTEL_LOG_LEVEL=warn
# Optional: Custom headers for remote collectors (e.g., Honeycomb, Datadog)
# OTEL_EXPORTER_OTLP_HEADERS=



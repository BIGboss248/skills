import { getTranslations } from "next-intl/server";
import { Link } from "@/components/Link";
import { ROUTES } from "@/lib/routes";

export default async function Unauthorized() {
  const t = await getTranslations("errors.unauthorized");

  return (
    <div className="flex min-h-[60vh] flex-col items-center justify-center p-6 text-center">
      <h1 className="text-4xl font-extrabold text-foreground tracking-tight">401</h1>
      <h2 className="mt-2 text-xl font-semibold text-foreground">
        {t("title") || "Authentication Required"}
      </h2>
      <p className="mt-2 text-sm text-muted-foreground max-w-md">
        {t("description") || "You must be signed in to access this page."}
      </p>
      <Link
        href={ROUTES.AUTH || "/auth"}
        className="mt-6 rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow transition hover:opacity-90"
      >
        {t("signIn") || "Sign In"}
      </Link>
    </div>
  );
}

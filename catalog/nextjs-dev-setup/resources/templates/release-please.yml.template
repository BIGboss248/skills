name: CI, Release & Multi-Arch Publish

# Release contract:
#   quality gate -> Release Please -> human merges the release PR
#     -> release job creates the tag -> publish (amd64 + arm64) -> merge manifest
#
# The image jobs live in THIS workflow on purpose. Release Please uses
# GITHUB_TOKEN, and GitHub never starts a follow-up workflow run for tags or
# releases created with that token, so a separate `on: release` workflow would
# never fire. `publish`/`merge` consume the `release` job outputs in the same run.
#
# Until the user merges the release PR, `released` is false: no image is built,
# no tag is pushed, and `latest` does not move.

on:
  push:
    branches:
      - main
  pull_request:
    branches:
      - main

concurrency:
  # PR runs are disposable; `main` runs must never be cancelled mid-release.
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

permissions:
  contents: read

jobs:
  quality:
    name: Lint, typecheck, unit and browser tests
    runs-on: ubuntu-latest
    timeout-minutes: 25
    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Install pnpm
        uses: pnpm/action-setup@v4
        with:
          run_install: false

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: "pnpm"

      - name: Install Dependencies
        run: pnpm install --frozen-lockfile

      - name: Lint
        run: pnpm lint

      - name: Typecheck
        run: pnpm exec tsc --noEmit

      # Fail fast on the in-memory tier before installing browsers.
      - name: Run Jest Unit Tests
        run: pnpm test

      # Cache Playwright browser binaries to eliminate recurring download time.
      - name: Cache Playwright Browsers
        uses: actions/cache@v4
        id: playwright-cache
        with:
          path: ~/.cache/ms-playwright
          key: ${{ runner.os }}-playwright-${{ hashFiles('**/pnpm-lock.yaml') }}

      - name: Install Playwright Browsers & OS Dependencies
        if: steps.playwright-cache.outputs.cache-hit != 'true'
        run: pnpm exec playwright install --with-deps

      # Static-shell (no-JS) assertions must read the raw response or run against
      # `next build` + `next start`; `next dev` streams behind `loading.tsx` and
      # hides the prerendered shell from a JavaScript-disabled browser.
      - name: Run Playwright E2E Tests
        run: pnpm test:e2e

      # Next.js build cache: prevents a full rebuild and the "No Cache Detected"
      # diagnostic on every run.
      - name: Restore Next.js Build Cache
        uses: actions/cache@v4
        with:
          path: ${{ github.workspace }}/.next/cache
          key: ${{ runner.os }}-nextjs-${{ hashFiles('**/pnpm-lock.yaml') }}-${{ hashFiles('**/*.js', '**/*.jsx', '**/*.ts', '**/*.tsx', '**/*.json') }}
          restore-keys: |
            ${{ runner.os }}-nextjs-${{ hashFiles('**/pnpm-lock.yaml') }}-

      - name: Build
        run: pnpm build
        env:
          # Build-time origin: `NEXT_PUBLIC_*` values are inlined, so this must
          # match the image's public origin. Override with a repository variable.
          NEXT_PUBLIC_SITE_URL: ${{ vars.NEXT_PUBLIC_SITE_URL }}

  release:
    name: Release Please
    needs: [quality]
    if: github.event_name == 'push' && github.ref == 'refs/heads/main'
    runs-on: ubuntu-latest
    timeout-minutes: 10
    # Serialize release runs across pushes and never cancel one in flight.
    concurrency:
      group: release-please
      cancel-in-progress: false
    permissions:
      contents: write
      pull-requests: write
      issues: write
    outputs:
      # Root package (".") outputs are unprefixed.
      released: ${{ steps.release.outputs.releases_created }}
      version: ${{ steps.release.outputs.version }}
      tag: ${{ steps.release.outputs.tag_name }}
      sha: ${{ steps.release.outputs.sha }}
    steps:
      # Requires release-please-config.json + .release-please-manifest.json.
      # For a single root package with `include-component-in-tag: false`, the
      # config MUST keep `package-name: ""`; otherwise the merged release PR
      # stays on `autorelease: pending` ("PR component: undefined does not match
      # configured component") and no release or image is ever produced.
      - name: Run Release Please
        id: release
        uses: googleapis/release-please-action@v4
        with:
          config-file: release-please-config.json
          manifest-file: .release-please-manifest.json

  # Builds each architecture on its native hosted runner (no QEMU) and pushes
  # by digest. The `merge` job owns the tag names, so the two legs never race.
  publish:
    name: Publish image (${{ matrix.platform }})
    needs: [release]
    if: github.event_name == 'push' && github.ref == 'refs/heads/main' && needs.release.outputs.released == 'true'
    strategy:
      fail-fast: false
      matrix:
        include:
          - runner: ubuntu-latest
            platform: linux/amd64
            arch: amd64
          - runner: ubuntu-24.04-arm
            platform: linux/arm64
            arch: arm64
    runs-on: ${{ matrix.runner }}
    timeout-minutes: 30
    permissions:
      contents: read
      packages: write
    steps:
      # Build the released commit, not the push SHA: next.config.ts reads
      # package.json for NEXT_PUBLIC_APP_VERSION, so the baked version must match
      # the image tag even if Release Please tagged an earlier commit.
      - name: Checkout Released Commit
        uses: actions/checkout@v4
        with:
          ref: ${{ needs.release.outputs.tag }}

      - name: Lowercase Repository Name
        run: |
          echo "IMAGE_NAME=$(echo "ghcr.io/${{ github.repository }}" | tr '[:upper:]' '[:lower:]')" >> "$GITHUB_ENV"

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Log in to GitHub Container Registry
        uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.repository_owner }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Resolve Release Metadata
        id: release_meta
        env:
          RELEASE_VERSION: ${{ needs.release.outputs.version }}
          RELEASE_SHA: ${{ needs.release.outputs.sha }}
        run: |
          echo "version=${RELEASE_VERSION}" >> "$GITHUB_OUTPUT"
          echo "short=${RELEASE_SHA::7}" >> "$GITHUB_OUTPUT"

      - name: Extract Docker Metadata (labels)
        id: meta
        uses: docker/metadata-action@v5
        with:
          images: ${{ env.IMAGE_NAME }}
          labels: |
            org.opencontainers.image.source=https://github.com/${{ github.repository }}
            org.opencontainers.image.revision=${{ needs.release.outputs.sha }}
            org.opencontainers.image.version=${{ steps.release_meta.outputs.version }}

      # Adjust the Dockerfile path when N11 places the build definition elsewhere.
      - name: Build and Push by Digest
        id: build
        uses: docker/build-push-action@v6
        with:
          context: .
          file: ./prod/Dockerfile
          platforms: ${{ matrix.platform }}
          labels: ${{ steps.meta.outputs.labels }}
          outputs: type=image,name=${{ env.IMAGE_NAME }},push-by-digest=true,name-canonical=true,push=true
          build-args: |
            GIT_SHA=${{ steps.release_meta.outputs.short }}
            NEXT_PUBLIC_SITE_URL=${{ vars.NEXT_PUBLIC_SITE_URL }}
          cache-from: type=gha,scope=${{ matrix.arch }}
          cache-to: type=gha,mode=max,scope=${{ matrix.arch }}

      - name: Export Digest
        run: |
          mkdir -p /tmp/digests
          digest="${{ steps.build.outputs.digest }}"
          touch "/tmp/digests/${digest#sha256:}"

      - name: Upload Digest
        uses: actions/upload-artifact@v4
        with:
          name: digests-${{ matrix.arch }}
          path: /tmp/digests/*
          if-no-files-found: error
          retention-days: 1

  # Joins the architecture digests into one manifest list and applies the
  # Release Please version tags.
  merge:
    name: Publish multi-arch manifest
    needs: [release, publish]
    if: github.event_name == 'push' && github.ref == 'refs/heads/main' && needs.release.outputs.released == 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      contents: read
      packages: write
    steps:
      - name: Download Digests
        uses: actions/download-artifact@v4
        with:
          path: /tmp/digests
          pattern: digests-*
          merge-multiple: true

      - name: Lowercase Repository Name
        run: |
          echo "IMAGE_NAME=$(echo "ghcr.io/${{ github.repository }}" | tr '[:upper:]' '[:lower:]')" >> "$GITHUB_ENV"

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Log in to GitHub Container Registry
        uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.repository_owner }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Resolve Release Metadata
        id: release_meta
        env:
          RELEASE_VERSION: ${{ needs.release.outputs.version }}
          RELEASE_SHA: ${{ needs.release.outputs.sha }}
        run: |
          echo "version=${RELEASE_VERSION}" >> "$GITHUB_OUTPUT"
          echo "short=${RELEASE_SHA::7}" >> "$GITHUB_OUTPUT"

      - name: Create and Push Manifest List
        working-directory: /tmp/digests
        env:
          VERSION: ${{ steps.release_meta.outputs.version }}
          SHORT: ${{ steps.release_meta.outputs.short }}
        run: |
          digests=()
          for digest in *; do
            digests+=("${IMAGE_NAME}@sha256:${digest}")
          done
          docker buildx imagetools create \
            -t "${IMAGE_NAME}:${VERSION}" \
            -t "${IMAGE_NAME}:${VERSION}-sha-${SHORT}" \
            -t "${IMAGE_NAME}:sha-${SHORT}" \
            -t "${IMAGE_NAME}:latest" \
            "${digests[@]}"

      - name: Inspect Manifest
        env:
          VERSION: ${{ steps.release_meta.outputs.version }}
        run: docker buildx imagetools inspect "${IMAGE_NAME}:${VERSION}"

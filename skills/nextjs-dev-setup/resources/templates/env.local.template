# ==============================================================================
# Next.js Local Development Environment Overrides (.env.local)
# Used for Local Testing, Emulators & Local Dev Server (Ignored in Git)
# ==============================================================================
#
# NOTES:
# - Loaded automatically by 'next dev' and local development scripts.
# - Overrides default variables in .env without affecting production builds.
# - NOT loaded during 'NODE_ENV=test' (Jest/Playwright use isolated defaults).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Local Development Server Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOSTNAME=127.0.0.1
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Local Container & Reverse Proxy Defaults
# ------------------------------------------------------------------------------
DOMAIN_NAME=localhost
CONTAINER_NAME=nextjs-standalone-app
IMAGE_TAG=local

# ------------------------------------------------------------------------------
# 3. Email & Contact Form (Local Mock / Sandbox)
# ------------------------------------------------------------------------------
CONTACT_RECIPIENT_EMAIL=dev@localhost
RESEND_API_KEY=

# ------------------------------------------------------------------------------
# 4. Real User Monitoring (RUM) & Web Vitals
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_WEB_VITALS=true
NEXT_PUBLIC_VITALS_ENDPOINT=/api/telemetry/vitals

# ------------------------------------------------------------------------------
# 5. OpenTelemetry (OTel) Local Tracing
# ------------------------------------------------------------------------------
OTEL_SDK_DISABLED=true
OTEL_SERVICE_NAME=<project-name>-dev
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/json
OTEL_BSP_SCHEDULE_DELAY=1000
OTEL_LOG_LEVEL=info

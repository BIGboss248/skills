{
  "project_context_and_metadata": {
    "package_manager": "pnpm",
    "new_component_dir": "app/components",
    "style_file_dir": "app/globals.css",
    "component_library": "shadcn/ui",
    "theme_strategy": "class",
    "theme_storage_key": "theme",
    "theme_toggle_path": "app/components/ThemeToggle.tsx",
    "animation_library": ["gsap"],
    "testing_library": [
      "jest",
      "playwright",
      "@testing-library/react",
      "@testing-library/jest-dom"
    ],
    "supported_languages": [
      {
        "language_code": "en",
        "country_code": "US",
        "currency_code": "USD",
        "direction": "ltr",
        "native_name": "English",
        "calendar_type": "gregorian"
      },
      {
        "language_code": "fa",
        "country_code": "IR",
        "currency_code": "IRR",
        "direction": "rtl",
        "native_name": "فارسی",
        "calendar_type": "persian"
      }
    ],
    "dictionaries_dir": "messages",
    "dictionary_file_pattern": "[locale].json",
    "agents": {
      "roster": "three-role",
      "orchestrator": {
        "agent": "nextjs-orchestrator",
        "path": ".opencode/agents/nextjs-orchestrator.md",
        "model": null,
        "enabled": true
      },
      "roles": [
        {
          "role": "implementation",
          "agent": "nextjs-dev",
          "path": ".opencode/agents/nextjs-dev.md",
          "model": null,
          "enabled": true
        },
        {
          "role": "test-author",
          "agent": "nextjs-test-author",
          "path": ".opencode/agents/nextjs-test-author.md",
          "model": null,
          "enabled": true
        },
        {
          "role": "qa-auditor",
          "agent": "nextjs-qa-auditor",
          "path": ".opencode/agents/nextjs-qa-auditor.md",
          "model": null,
          "enabled": true
        }
      ],
      "boundaries_rule": ".agents/rules/agent-boundaries.md",
      "worktree_isolation": {
        "enabled": true,
        "helper": "scripts/agent-worktree.ps1",
        "branch_prefix": "agent/",
        "base_branch": "main",
        "on_conflict": "ask_user"
      },
      "test_tiers": {
        "development": "fast",
        "prepush": "full",
        "prepush_script": "test:prepush"
      },
      "commands": [
        ".opencode/commands/create-nextjs-component.md",
        ".opencode/commands/create-nextjs-page.md"
      ]
    }
  }
}


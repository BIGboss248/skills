"use client";

import * as React from "react";
import { ProgressBarProvider, ProgressBar } from "@vercel/react-transition-progress";
import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
import { ThemeProvider } from "next-themes";

export function Providers({ children }: { children: React.ReactNode }) {
  const [queryClient] = React.useState(
    () =>
      new QueryClient({
        defaultOptions: {
          queries: {
            staleTime: 60 * 1000,
          },
        },
      })
  );

  return (
    <ProgressBarProvider>
      <ProgressBar className="fixed top-0 left-0 right-0 z-[9999] h-1 bg-primary shadow-[0_0_10px_rgba(var(--primary-rgb),0.5)] transition-all duration-200" />
      <QueryClientProvider client={queryClient}>
        <ThemeProvider attribute="class" defaultTheme="system" enableSystem disableTransitionOnChange>
          {children}
        </ThemeProvider>
      </QueryClientProvider>
    </ProgressBarProvider>
  );
}

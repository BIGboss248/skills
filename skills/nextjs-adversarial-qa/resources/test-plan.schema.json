{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NextjsQaReport",
  "type": "object",
  "required": [
    "status",
    "mode",
    "target",
    "files_created",
    "commands",
    "cases",
    "verdict"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["PASS", "FAIL", "BLOCKED"]
    },
    "mode": {
      "type": "string",
      "enum": ["baseline", "page", "adversarial", "repair", "audit"]
    },
    "target": {
      "type": "object",
      "required": ["kind", "name"],
      "properties": {
        "kind": { "type": "string", "enum": ["component", "page"] },
        "name": { "type": "string" },
        "path": { "type": "string" },
        "route": { "type": "string" }
      }
    },
    "plan_path": { "type": "string" },
    "files_created": {
      "type": "array",
      "items": { "type": "string" }
    },
    "commands": {
      "type": "array",
      "items": { "type": "string" }
    },
    "cases": {
      "type": "object",
      "required": ["passed", "failed", "skipped"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 }
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["test", "severity", "reason"],
        "properties": {
          "test": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["critical", "major", "minor", "info"]
          },
          "reason": { "type": "string" }
        }
      }
    },
    "code_fixes_required": {
      "type": "array",
      "items": { "type": "string" }
    },
    "coverage_gaps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "verdict": {
      "type": "string",
      "enum": ["PASS", "FAIL", "BLOCKED"]
    }
  }
}
